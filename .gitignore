New-Item -Path .gitignore -ItemType File -Value @"
# Python cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# Virtual environment (jika ada)
venv/
.venv/
env/

# Model serialization (opsional jika file terlalu besar)
# *.joblib

# OS metadata
Thumbs.db
.DS_Store
"@